# ──────────────────────────────────────────────────────────────────────────
# WEGEK — AI 3D Website Factory · environment configuration
#
# EVERYTHING here is OPTIONAL. With zero keys, WEGEK runs fully on procedural
# generation (heuristic planner + parametric Three.js geometry + curated GLSL)
# and still produces a complete, runnable 3D website. Add keys to upgrade each
# stage to real AI assets — they enhance, they're never required.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed origins, or "*" for any.
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── Stage 0 · Planner LLM (Anthropic or OpenAI) ──────────────────────────────
# PLANNER_PROVIDER: auto | anthropic | openai   (auto = anthropic > openai > heuristic)
PLANNER_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Stage 1 · Image generation (Black Forest Labs FLUX) ──────────────────────
# BFL_API_KEY=...
BFL_BASE_URL=https://api.bfl.ai/v1
BFL_MODEL=flux-pro-1.1

# ── Stage 2/3 · Image→3D + auto-rig (Tripo) ──────────────────────────────────
# TRIPO_API_KEY=...
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v2.5-20250123

# ── Stage 4 · GLSL shader generation ─────────────────────────────────────────
# When true and an LLM key is set, shaders are authored by the LLM; otherwise
# the curated shader library is used.
SHADER_USE_LLM=true

# ── Stage 7 · Render review (optional puppeteer-capture service) ─────────────
# Leave empty to use fast structural review instead of screenshot capture.
# RENDERER_URL=http://localhost:8200
REVIEW_MAX_ITERATIONS=3
REVIEW_PASS_SCORE=0.78

# ── Pipeline behaviour ───────────────────────────────────────────────────────
MAX_OBJECTS_PER_SITE=8
REQUEST_TIMEOUT=120
POLL_INTERVAL=2
POLL_TIMEOUT=300
