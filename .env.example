# ── Planner / image LLM (Gemini) ─────────────────────────────────────────────
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Tripo (mesh outsourcing: image -> 3D) ────────────────────────────────────
# TRIPO_API_KEY=...
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_TEXTURE_QUALITY=detailed

# ── Blender render host ──────────────────────────────────────────────────────
# interpreter that has the `bpy` module installed (pip install bpy)
BLENDER_PYTHON=python
RENDER_SAMPLES=24
RENDER_WIDTH=1280
RENDER_HEIGHT=720
FRAMES_PER_SCENE=48
